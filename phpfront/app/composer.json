{
  "name": "titpetric/task-ui-front",

  "description": "The task-ui front end: a phpscript application of a theme and a module per view",

  "license": "MIT",

  "type": "project",

  "repositories": [
    { "type": "vcs", "url": "https://git.cdn.si/titpetric/mdedit" }
  ],

  "config": {
    "vendor-dir": "ext",
    "allow-plugins": {
      "composer/installers": true,
      "oomphinc/composer-installers-extender": true
    }
  },

  "autoload": {
    "psr-4": {
      "Task\\": "code/Task/"
    },
    "classmap": ["code/", "modules/"],
    "exclude-from-classmap": ["modules/*/templates_c/", "**/mod_*.php"]
  },

  "require": {
    "titpetric/minitpl": "^1.3",
    "titpetric/mdedit": "dev-main",
    "oomphinc/composer-installers-extender": "^2.0"
  },

  "scripts": {
    "post-install-cmd": ["rm -rf theme/assets/ext/mdedit/.git"],
    "post-update-cmd": ["rm -rf theme/assets/ext/mdedit/.git"]
  },

  "extra": {
    "installer-types": ["mdedit-asset"],
    "installer-paths": {
      "theme/assets/ext/{$name}": ["type:mdedit-asset"]
    }
  }
}
