<span class="copyable{if $data_copy.fill} fill{/if}"><code{if $data_copy.fill || $data_copy.shown !== $data_copy.value} title="{data_copy.value}"{/if}>{data_copy.shown}</code><button type="button" class="btn-icon" data-copy="{data_copy.value}" title="Copy {data_copy.label}" aria-label="Copy {data_copy.label}"><i class="ic ic-copy" aria-hidden="true"></i></button></span>
