<span class="cc-slot" data-cc="{data_cc.key}" data-folder="{data_cc.folder}" data-job="{data_cc.job}" data-name="{data_cc.name}" data-label="{data_cc.label}" data-last="{data_cc.last}"{if $data_cc.can} data-can{/if}{if $data_cc.dir} data-dir="{data_cc.dir}"{/if}{if $data_cc.desc} data-desc="{data_cc.desc}"{/if}{if $data_cc.args} data-args="{data_cc.args}"{/if}{if $data_cc.confirm} data-confirm="{data_cc.confirm}"{/if}{if $data_cc.path} data-path="{data_cc.path}"{/if}{if $data_cc.terminal} data-interactive{/if}>{if $data_cc.run}<a class="cc named{if $data_cc.pinned} pinned{/if} running" href="{base}/runs/{data_cc.run}" data-attach="{data_cc.run}" title="{data_cc.title}"><svg class="ic"><use href="#i-eye"/></svg><span>{data_cc.label}</span></a>{elseif $data_cc.can}<button type="button" class="cc named{if $data_cc.pinned} pinned{/if} {data_cc.last}" data-run data-folder="{data_cc.folder}"{if $data_cc.dir} data-dir="{data_cc.dir}"{/if} data-job="{data_cc.job}" data-title="{data_cc.what}"{if $data_cc.confirm} data-confirm="{data_cc.confirm}" data-confirm-ok="Run {data_cc.name}"{/if}{if $data_cc.args} data-args="{data_cc.args}"{/if} title="{data_cc.title}"><svg class="ic"><use href="#i-{if $data_cc.terminal}terminal{else}play{/if}"/></svg><span>{data_cc.label}</span></button>{else}<a class="cc named{if $data_cc.pinned} pinned{/if} idle {data_cc.last}" href="{data_cc.href}" title="{data_cc.title}"><i class="shebang" aria-hidden="true">#!</i><span>{data_cc.label}</span></a>{/if}</span>
