# Users to seed on startup. Passwords are bcrypt hashes from
# `task-ui hash <password>`, or plain text, hashed when seeded. Who may run
# what is set per folder in Settings, Projects.
users:
  - name: admin
    password: "$2a$10$replace-with-task-ui-hash"
    role: admin
  - name: ops
    password: "$2a$10$replace-with-task-ui-hash"
    role: runner
  - name: guest
    password: "$2a$10$replace-with-task-ui-hash"
    role: viewer
    folders: [infra, website]
