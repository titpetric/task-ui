# Who may sign in: one name:hash per line, bcrypt only.
#   task-ui passwd alice          adds or resets alice
#   htpasswd -B .htpasswd alice   the same with apache2-utils
# The first users of an empty database are admins; a later one comes in as a viewer.
admin:$2a$10$replace-with-task-ui-passwd
ops:$2a$10$replace-with-task-ui-passwd
guest:$2a$10$replace-with-task-ui-passwd
